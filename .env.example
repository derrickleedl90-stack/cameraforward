PORT=3000
SESSION_TTL_MINUTES=120

# Comma-separated STUN URLs. Configure servers you are authorized to use.
STUN_URLS=stun:stun.example.com:3478

# TURN is required for reliable cross-network connectivity.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=replace-with-time-limited-username
TURN_CREDENTIAL=replace-with-time-limited-credential
